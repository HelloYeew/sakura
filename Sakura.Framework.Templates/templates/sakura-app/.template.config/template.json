{
  "$schema": "http://json.schemastore.org/template",
  "author": "HelloYeew",
  "classifications": ["Game", "Desktop", "Android", "Graphics"],
  "identity": "Sakura.Framework.Templates.SakuraApp",
  "name": "Sakura Framework App",
  "description": "A cross-platform game/app project using Sakura Framework.",
  "shortName": "sakura",
  "sourceName": "MyApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "FrameworkVersion": {
      "type": "parameter",
      "description": "The Sakura.Framework NuGet version to reference.",
      "datatype": "string",
      "defaultValue": "*-*",
      "replaces": "*-*"
    },
    "android": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Also make an Android project (needs the .NET Android workload: dotnet workload install android).",
      "defaultValue": "false"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If true, skips the automatic restore of the project on create.",
      "defaultValue": "false",
      "displayName": "Skip restore"
    }
  },
  "sources": [
    {
      "modifiers": [
        { "condition": "(!android)", "exclude": ["MyApp.Android/**"] }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "MyApp.sln" },
    { "path": "MyApp/MyAppApp.cs" },
    { "path": "MyApp.Desktop/Program.cs" },
    { "condition": "(android)", "path": "MyApp.Android/MyApp.Android.csproj" }
  ],
  "postActions": [
    {
      "condition": "(android)",
      "description": "Adds the Android project to the solution.",
      "manualInstructions": [{ "text": "Add MyApp.Android/MyApp.Android.csproj to MyApp.sln." }],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "args": { "primaryOutputIndexes": "3" },
      "continueOnError": true
    }
  ]
}
