<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!--
      NUnit1032 (dispose IDisposable fields in [TearDown]) fires on every test that holds a drawable in a
      field, because Drawable became IDisposable with the disposal cascade. Disposing a test's root
      container releases nothing these tests own — a drawable's disposal exists to release textures,
      framebuffers and decoders, and unit-test roots hold none — while a real tree is torn down by its
      parent as soon as it is removed. Tests that do build resource-owning drawables dispose them
      explicitly where the disposal is the thing under test.
    -->
    <NoWarn>$(NoWarn);NUnit1032</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sakura.Framework\Sakura.Framework.csproj" />
  </ItemGroup>
</Project>
