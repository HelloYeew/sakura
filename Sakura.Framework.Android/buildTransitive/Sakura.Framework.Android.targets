<Project>
  <!--
    .NET for Android packages a fast-deployment (Debug) build without watching libxamarin-app.so, which holds the type map from
    managed types to Java ones; the embedded-assembly packaging does watch it. Rebuilding an assembly with Java types in it
    (Sakura.Framework.Android, whenever the framework changes) gives it a new MVID and libxamarin-app.so a new type map, but the
    APK keeps the old one, and the app dies at start with "no Java peer type found". Watching the library repackages the APK
    when it changes.
  -->
  <Target Name="SakuraRepackageWhenTypeMapChanges" BeforeTargets="_BuildApkFastDev">
    <PropertyGroup>
      <_BuildApkFastDevStaticInputs>$(_BuildApkFastDevStaticInputs);@(_ApplicationSharedLibrary)</_BuildApkFastDevStaticInputs>
    </PropertyGroup>
  </Target>

  <!--
    With assembly compression off (so assemblies are mapped from the APK rather than inflated at launch), .NET for Android
    36.1 leaves compressed_assembly_count, compressed_assembly_descriptors and uncompressed_assemblies_data_size out of
    libxamarin-app.so, since there's nothing compressed to describe. CoreCLR's Release host, libmonodroid.so, still links
    them, so a Release build dies at start in dlopen ("cannot locate symbol compressed_assembly_count"); Debug's doesn't.
    They're added here as what they mean, no compressed assemblies, wherever the generated source lacks them.
  -->
  <Target Name="SakuraDeclareNoCompressedAssemblies"
          AfterTargets="_GenerateCompressedAssembliesNativeSourceFiles"
          Condition=" '$(UseMonoRuntime)' == 'false' And '$(AndroidEnableAssemblyCompression)' == 'false' ">
    <WriteLinesToFile
        File="%(_CompressedAssembliesAssemblySource.FullPath)"
        Condition=" Exists('%(_CompressedAssembliesAssemblySource.FullPath)') And !$([System.IO.File]::ReadAllText('%(_CompressedAssembliesAssemblySource.FullPath)').Contains('@compressed_assembly_count')) "
        Lines="@compressed_assembly_count = dso_local local_unnamed_addr constant i32 0, align 4;@compressed_assembly_descriptors = dso_local local_unnamed_addr global [0 x %25struct.CompressedAssemblyDescriptor] zeroinitializer, align 4;@uncompressed_assemblies_data_size = dso_local local_unnamed_addr constant i32 0, align 4"
        Overwrite="false" />
  </Target>

  <!--
    The .NET 11 SDK names Android to crossgen2 as "android", which only crossgen2 11 knows. A net10.0-android app is
    precompiled (ReadyToRun, as a Release build on CoreCLR is) by the .NET 10 crossgen2, which stops at "Target OS 'android'
    is not supported". The .NET 10 SDK named it "linux" to that same compiler, and so does this.
  -->
  <Target Name="SakuraPrecompileAndroidAsLinux"
          AfterTargets="ResolveReadyToRunCompilers"
          Condition=" '$(TargetPlatformIdentifier)' == 'android' And $([MSBuild]::VersionLessThan('$(TargetFrameworkVersion)', '11.0')) ">
    <ItemGroup>
      <Crossgen2Tool Update="@(Crossgen2Tool)" TargetOS="linux" Condition=" '%(Crossgen2Tool.TargetOS)' == 'android' " />
    </ItemGroup>
  </Target>
</Project>
