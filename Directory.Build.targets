<Project>
  <!-- What an Android app gets with Sakura.Framework.Android from NuGet, for the apps in this repository. -->
  <Import Project="$(MSBuildThisFileDirectory)Sakura.Framework.Android/buildTransitive/Sakura.Framework.Android.targets" />

  <!-- What an iOS app gets with Sakura.Framework.iOS from NuGet, for the apps in this repository. -->
  <Import Project="$(MSBuildThisFileDirectory)Sakura.Framework.iOS/buildTransitive/Sakura.Framework.iOS.targets" />

  <!-- libpng, which FreeTypeSharp's iOS FreeType needs and doesn't ship, from this repository's native libraries until a
       Sakura.Framework.NativeLibraries release carries it. -->
  <ItemGroup Condition=" '$(TargetPlatformIdentifier)' == 'ios' And '$(OutputType)' == 'Exe' ">
    <NativeReference Include="$(MSBuildThisFileDirectory)Sakura.Framework.NativeLibraries/runtimes/ios/native/libpng16.xcframework" Kind="Static" />
  </ItemGroup>

  <!-- .NET 11 RC 2's iOS Debug build ReadyToRun-compiles the assemblies it takes for packages, which includes the
       framework when it comes in through another project, and bundles the copies that compile writes. It notices when
       one of them changes, but the compile doesn't count them as its inputs and is skipped, so the app keeps the old
       copies. Removing the compile's output makes it run. Remove once a workload rebuilds them itself. -->
  <Target Name="RecompileChangedReadyToRunAssemblies"
          Condition=" '$(TargetPlatformIdentifier)' == 'ios' And '$(_R2RInputHashChanged)' == 'true' "
          AfterTargets="_PrepareForReadyToRunCompilation"
          BeforeTargets="_CreateR2RImages">
    <Delete Files="@(_ReadyToRunCompileList->'%(OutputR2RImage)')" />
  </Target>

  <!-- iOS has no JIT, so in a Debug build whatever the ReadyToRun compile leaves out runs in the interpreter, many times
       slower. Unless told otherwise it compiles only what CoreLib needs, so the framework would be interpreted too;
       compiling all of it keeps the apps here close to Release speed, while their own code stays interpreted and
       debuggable. -->
  <Target Name="PrecompileFrameworkInDebug"
          Condition=" '$(TargetPlatformIdentifier)' == 'ios' And '$(FilterReadyToRunAssemblies)' == 'true' "
          AfterTargets="_SelectR2RAssemblies">
    <ItemGroup>
      <PublishReadyToRunCompositeRoots Include="Sakura.Framework.dll" />
    </ItemGroup>
  </Target>
</Project>
